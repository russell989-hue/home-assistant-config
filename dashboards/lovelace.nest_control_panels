          "max_columns": 3,
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Right now",
                  "heading_style": "title",
                  "icon": "mdi:flash"
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "Solar production",
                  "secondary": "{{ states(\"sensor.envoy_202504003929_current_power_production\") | int }} W",
                  "icon": "mdi:solar-power-variant",
                  "icon_color": "yellow",
                  "fill_container": true
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "Grid",
                  "secondary": "{% set v = states(\"sensor.xcel_itron_5_instantaneous_demand_value\") | int(0) %}\n{{ v | abs }} W {{ \"(importing)\" if v > 0 else \"(exporting)\" if v < 0 else \"(idle)\" }}\n",
                  "icon": "mdi:transmission-tower",
                  "icon_color": "{% set v = states(\"sensor.xcel_itron_5_instantaneous_demand_value\") | int(0) %}\n{% if v < 0 %}green{% elif v < 1000 %}blue{% elif v < 5000 %}orange{% else %}red{% endif %}\n",
                  "fill_container": true
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "Shadowfax",
                  "secondary": "{% if is_state(\"binary_sensor.shadowfax_charging_status\", \"on\") %}\nCharging — {{ states(\"sensor.shadowfax_battery_state_of_charge\") | int }}%, {{ states(\"sensor.shadowfax_charging_time_remaining\") }} min left\n{% else %}\n{{ states(\"sensor.shadowfax_battery_state_of_charge\") | int }}% · idle\n{% endif %}\n",
                  "icon": "mdi:car-electric",
                  "icon_color": "{{ \"green\" if is_state(\"binary_sensor.shadowfax_charging_status\", \"on\") else \"blue\" }}\n",
                  "multiline_secondary": true,
                  "fill_container": true
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Solar today & forecast",
                  "icon": "mdi:solar-panel"
