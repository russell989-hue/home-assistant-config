      "title": "Nest Control Panels",
      "views": [
        {
          "title": "Overview",
          "path": "overview",
          "icon": "mdi:home",
          "type": "sections",
          "max_columns": 3,
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Weather",
                  "heading_style": "title",
                  "icon": "mdi:weather-partly-cloudy"
                },
                {
                  "type": "weather-forecast",
                  "entity": "weather.forecast_home_2",
                  "forecast_type": "daily",
                  "show_current": true,
                  "show_forecast": true
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Who's home",
                  "icon": "mdi:account-group"
                },
                {
                  "type": "custom:mushroom-person-card",
                  "entity": "person.brianrussell",
                  "use_entity_picture": true,
                  "secondary_info": "state"
                },
                {
                  "type": "custom:mushroom-person-card",
                  "entity": "person.nick",
                  "use_entity_picture": true,
                  "secondary_info": "state"
                },
                {
                  "type": "custom:material-users-card",
                  "is_add_button_enabled": true
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Climate",
                  "icon": "mdi:thermostat"
                },
                {
                  "type": "custom:mushroom-climate-card",
                  "entity": "climate.main_floor",
                  "name": "Main Floor",
                  "show_temperature_control": true,
                  "hvac_modes": [
                    "heat",
                    "cool",
                    "heat_cool",
                    "off"
                  ]
                },
                {
                  "type": "custom:mushroom-climate-card",
                  "entity": "climate.upstairs_thermostat",
                  "name": "Upstairs",
                  "show_temperature_control": true,
                  "hvac_modes": [
                    "heat",
                    "cool",
                    "off"
                  ]
                },
                {
                  "type": "custom:mushroom-entity-card",
                  "entity": "sensor.downstairs_temperature",
                  "name": "Downstairs",
                  "icon": "mdi:thermometer"
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Locks",
                  "icon": "mdi:lock"
                },
                {
                  "type": "custom:mushroom-lock-card",
                  "entity": "lock.front_door",
                  "name": "Front Door",
                  "secondary_info": "Battery {{ states(\"sensor.front_door_battery_2\") }}%\n"
                },
                {
                  "type": "custom:mushroom-lock-card",
                  "entity": "lock.side_door",
                  "name": "Side Door"
                },
                {
                  "type": "custom:mushroom-lock-card",
                  "entity": "lock.side_door_2",
                  "name": "Side Door 2"
                },
                {
                  "type": "heading",
                  "heading": "Energy",
                  "icon": "mdi:flash"
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "Grid",
                  "secondary": "{{ states(\"sensor.xcel_itron_5_instantaneous_demand_value\") | int }} W",
                  "icon": "mdi:transmission-tower",
                  "icon_color": "blue",
                  "entity": "sensor.xcel_itron_5_instantaneous_demand_value",
                  "tap_action": {
                    "action": "navigate",
                    "navigation_path": "/energy"
                  }
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "Grid CO₂",
                  "secondary": "{{ states(\"sensor.electricity_maps_co2_intensity\") | int }} g/kWh",
                  "icon": "mdi:molecule-co2",
                  "icon_color": "{% set v = states(\"sensor.electricity_maps_co2_intensity\") | int(0) %}\n{% if v < 200 %}green{% elif v < 400 %}orange{% else %}red{% endif %}\n",
                  "entity": "sensor.electricity_maps_co2_intensity"
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "Solar",
                  "secondary": "{{ states(\"sensor.envoy_202504003929_current_power_production\") | int }} W",
                  "icon": "mdi:solar-power-variant",
                  "icon_color": "yellow",
                  "entity": "sensor.envoy_202504003929_current_power_production",
                  "tap_action": {
                    "action": "navigate",
                    "navigation_path": "/energy"
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Heads-up",
                  "icon": "mdi:alert-circle"
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "numeric_state",
                      "entity": "sensor.front_door_battery_2",
                      "below": 20
                    }
                  ],
                  "card": {
                    "type": "custom:mushroom-template-card",
                    "primary": "Front-door lock battery LOW",
                    "secondary": "{{ states(\"sensor.front_door_battery_2\") }}%",
                    "icon": "mdi:battery-alert",
                    "icon_color": "red",
                    "fill_container": true
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "numeric_state",
                      "entity": "sensor.home_aqi_us_aqi",
                      "above": 50
                    }
                  ],
                  "card": {
                    "type": "custom:mushroom-template-card",
                    "primary": "Air quality reduced",
                    "secondary": "AQI {{ states(\"sensor.home_aqi_us_aqi\") }} · {{ states(\"sensor.home_aqi_us_dominant_pollutant\") }}",
                    "icon": "mdi:weather-hazy",
                    "icon_color": "orange"
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "or",
                      "conditions": [
                        {
                          "condition": "numeric_state",
                          "entity": "sensor.brians_ipad_783_battery_level",
                          "below": 20
                        },
                        {
                          "condition": "numeric_state",
                          "entity": "sensor.office_ha_display_battery_level",
                          "below": 20
                        },
                        {
                          "condition": "numeric_state",
                          "entity": "sensor.control_panel_battery_level",
                          "below": 30
                        }
                      ]
                    }
                  ],
                  "card": {
                    "type": "entities",
                    "title": "Devices needing a charge",
                    "entities": [
                      {
                        "entity": "sensor.brians_ipad_783_battery_level",
                        "name": "Brian's iPad"
                      },
                      {
                        "entity": "sensor.office_ha_display_battery_level",
                        "name": "Office HA Display"
                      },
                      {
                        "entity": "sensor.control_panel_battery_level",
                        "name": "Control Panel"
                      },
                      {
                        "entity": "sensor.motorola_razr_2025_battery_level",
                        "name": "Razr"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Properties & travel",
                  "icon": "mdi:home-group"
                },
                {
                  "type": "custom:atomic-calendar-revive",
                  "name": "Bookings (next 14 days)",
                  "enableModeChange": true,
                  "defaultMode": "Event",
                  "maxDaysToShow": 14,
                  "entities": [
                    {
                      "entity": "calendar.riviera_airbnb",
                      "color": "#a855f7"
                    },
                    {
                      "entity": "calendar.zenobia_airbnb",
                      "color": "#3b82f6"
                    },
                    {
                      "entity": "calendar.northwoods",
