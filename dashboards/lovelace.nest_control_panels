      "decluttering_templates": {
        "cast_buttons": {
          "default": [
            {
              "dashboard_path": "home-overview"
            },
            {
              "view_path": "home-overview"
            }
          ],
          "card": {
            "type": "horizontal-stack",
            "cards": [
              {
                "type": "button",
                "name": "Kitchen",
                "icon": "mdi:cast",
                "icon_height": "28px",
                "tap_action": {
                  "action": "perform-action",
                  "perform_action": "cast.show_lovelace_view",
                  "data": {
                    "entity_id": "media_player.kitchen_max_display",
                    "dashboard_path": "[[dashboard_path]]",
                    "view_path": "[[view_path]]"
                  }
                }
              },
              {
                "type": "button",
                "name": "Office",
                "icon": "mdi:cast",
                "icon_height": "28px",
                "tap_action": {
                  "action": "perform-action",
                  "perform_action": "cast.show_lovelace_view",
