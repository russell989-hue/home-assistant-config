# ----------------------------------------------------
# Home Assistant .gitignore
# ----------------------------------------------------

# --- Secrets and credentials ---
secrets.yaml
.storage/
.google.token
.git-credentials
go2rtc.yaml
go2rtc-*
.cloud/
.ios.conf
.cache/

# --- Databases (never merge cleanly; may hold personal data) ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
home-assistant_v2.db*
zigbee.db*
llmvision/

# --- Logs and runtime state ---
*.log
home-assistant.log*
OZW_Log.txt
.ha_run.lock
__pycache__/
*.pyc

# --- Z-Wave / Zigbee device config ---
zwcfg_*.xml
zwscene.xml

# --- Personal data / media ---
.shopping_list.json
tts/
*.mp4
*.bak.*
www/clip_*.jpg
www/ring_frame.jpg
www/ring_frame.txt
www/clip_sheet.jpg
www/icloud3/
www/notif/
ics_files/

# --- OS clutter ---
.DS_Store
Thumbs.db
